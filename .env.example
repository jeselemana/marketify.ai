PORT=5050
NODE_ENV=development
APP_URL=http://localhost:5050
TRUSTED_ORIGINS=
ADMIN_USERNAMES=
OPENAI_API_KEY=
OPENAI_STRATEGY_MODEL=gpt-5.6-terra
OPENAI_ASK_MODEL=gpt-5.6-luna
MAX_CLARIFICATION_ROUNDS=2

# Google OAuth 2.0 (Google Sign-In) Client ID
GOOGLE_CLIENT_ID=471975374819-mgn2g8auc7q9eko71air922aoo7h963p.apps.googleusercontent.com

# Google Gemini / Vertex AI Configuration
# Set GEMINI_API_KEY with Google AI Studio (AIzaSy...) or Vertex AI Express Mode (AQ...) key.
GEMINI_API_KEY=
GEMINI_USE_VERTEX=true
GEMINI_ASK_MODEL=gemini-3.7-flash
# -1 = Dynamic thinking budget (recommended for Gemini 3.7 Flash with context), 0 = Disabled, >0 = Fixed tokens
GEMINI_THINKING_BUDGET=-1
GEMINI_MAX_OUTPUT_TOKENS=65536
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_FLASH_INPUT_USD_PER_1M=0.15
GEMINI_FLASH_OUTPUT_USD_PER_1M=0.60

# Optional: Redis store for sessions, user records, and strategies.
REDIS_URL=

# Email verification codes and password reset delivery. Required in production.
RESEND_API_KEY=
EMAIL_FROM=Marketify <no-reply@marketify-ai.com>

# SMTP is an alternative to Resend.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Cloudflare R2 persistent storage. Required unless a Render persistent disk is attached.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# AI Learning Loop v1. Prices are USD per 1M tokens. Leave unset/0 rather than
# guessing: affected interactions keep estimatedCost=null and are marked unpriced.
AI_LEARNING_CANDIDATE_THRESHOLD=0.75
AI_QUALITY_BASELINE=0.5
AI_QUALITY_EXPLICIT_POSITIVE=0.5
AI_QUALITY_EXPLICIT_NEGATIVE=-0.65
AI_QUALITY_ACCEPTED=0.3
AI_QUALITY_COPIED=0.12
AI_QUALITY_FINAL_ITERATION=0.22
AI_QUALITY_REGENERATED=-0.25
AI_QUALITY_EDITED=-0.12
AI_QUALITY_CORRECTION=-0.08
OPENAI_LUNA_INPUT_USD_PER_1M=0
OPENAI_LUNA_OUTPUT_USD_PER_1M=0
OPENAI_TERRA_INPUT_USD_PER_1M=0
OPENAI_TERRA_OUTPUT_USD_PER_1M=0
